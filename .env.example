# Server
PORT=3000

# MySQL connection
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Set to true when the MySQL provider requires TLS.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# First date that should exist in the dashboard snapshot.
DATA_START_DATE=2026-10-01

# Optional path for the local data snapshot.
# DATA_FILE=./data/snapshot.json
